# Copy to .env.local and use your Firebase web app configuration.
# Enable Google sign-in and Firestore in that project and authorize your domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Complete configuration enables sync. Set false to force local-only mode.
# VITE_ENABLE_GOOGLE_SYNC=false
